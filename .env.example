# Copy to .env (`cp .env.example .env`). dbmate reads DATABASE_URL from .env.
# Local Postgres from compose.yml.
DATABASE_URL=postgres://app:app@localhost:5432/app?sslmode=disable

# On Vercel, the Neon integration injects DATABASE_URL (pooled, for the app) and
# DATABASE_URL_UNPOOLED (direct, for migrations). Run migrations against Neon with
# `bunx dbmate -e DATABASE_URL_UNPOOLED --no-dump-schema up`.
